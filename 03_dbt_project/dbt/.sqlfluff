[sqlfluff]
# Jinja templater (not the dbt templater) so linting runs in CI without a warehouse connection.
# apply_dbt_builtins stubs ref/source/config/var; project macros (safe_divide, dbt_utils.*) can't be
# resolved this way, so templating errors are ignored and only real SQL style is enforced.
templater = jinja
dialect = databricks
max_line_length = 120
ignore = templating
exclude_rules = AM04, RF01, RF02, RF03, ST06, LT05, LT09

[sqlfluff:indentation]
tab_space_size = 4
indent_unit = space

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
